# 複製成 .env 後填入。.env 不會進 git。

# LLM(DeepSeek 或任何 OpenAI 相容 API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 模型 id 在 profiles/<id>/profile.toml 的 [llm.purposes] 設定

# Discord bot 帳號(文字 + 指令)
DISCORD_BOT_TOKEN=
# 你的 Discord user id,擁有者權限
MIYORIA_OWNER_ID=

# Admin API token(`miyoria init` 會自動產生)
MIYORIA_API_TOKEN=

# Self 帳號語音節點連線用 token(`miyoria init` 會自動產生;apps/voice-node 的 .env 要填同一個)
VOICE_LINK_TOKEN=

# 資料庫:memory:// = 不保存(測試用);Postgres 見 deploy/README.md
DATABASE_URL=memory://
