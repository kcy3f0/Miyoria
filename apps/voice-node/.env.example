# Miyoria voice-node 設定。複製成 .env 後填入。
# .env 已被 .gitignore 排除,絕對不要把真的 token commit 進 repo。

# self 帳號(專用小帳號,不要用主帳號)的 user token,由擁有者自己放進來
SELF_TOKEN=

# Core 的 voice.link 位址與共用 token(要跟 Core 的 [modules."voice.link"] 設定一致)
VOICE_LINK_URL=ws://127.0.0.1:7879/voice-link
VOICE_LINK_TOKEN=

# error | warn | info | debug
LOG_LEVEL=info

# ── 進階(都有預設值,通常不用改)──────────────────────────────
# 停止說話多久(ms)算一段串流結束(stream_close),建議 300~500
# SILENCE_MS=400
# 單一播放最多緩衝幾秒的音訊,超過就判定 failed
# PLAYBACK_MAX_BUFFER_S=60
# 開始播放前先累積幾 ms(避免一開始就斷斷續續)
# PLAYBACK_PREBUFFER_MS=60
# Core 還沒送下一段音訊時最多補靜音幾 ms,超過判定 failed
# PLAYBACK_MAX_STARVE_MS=10000

# ── Stage 嘴型 ──────────────────────────────────────────────────
# Stage 的 levels 端點;設了才會即時送嘴型音量({"t":ms,"rms":0..1}),Stage 沒開也沒關係(安靜重連)
# STAGE_LEVELS_URL=ws://127.0.0.1:7883/levels
# 送出的 RMS 乘上這個倍數(上限 1)。一般說話的 RMS 約 0.05~0.2,嘴型幅度不夠就調大
# STAGE_LEVELS_GAIN=1

# ── Go Live(Core 送 golive_start 時的預設值,請求內的欄位會蓋掉它們)────
# hybrid = 語音(收音 + TTS)和 Go Live 同時;exclusive = 推流期間離開語音,結束後自動回去
# GOLIVE_VOICE_MODE=hybrid
# auto(NVENC 能用就用,否則 x264)| nvenc | software
# GOLIVE_ENCODER=auto
# NVENC preset:p1~p3 延遲最低,p4 平衡
# GOLIVE_NVENC_PRESET=p4
# H264 | H265
# GOLIVE_CODEC=H264
# GOLIVE_HEIGHT=1080
# GOLIVE_FPS=60
# GOLIVE_BITRATE_KBPS=6000
# 峰值碼率 = 碼率 × 這個倍數
# GOLIVE_BITRATE_MAX_FACTOR=1.33
# 用 NVDEC 解輸入
# GOLIVE_HWACCEL_DECODE=true
# 直接轉送來源已編好的 H.264(OBS 要設 1 秒關鍵影格、無 B-frame),不再編碼
# GOLIVE_NO_TRANSCODE=false
# 直播帶上來源的音訊(她的聲音本來就走語音頻道;關掉也省掉送出端的音畫同步等待)
# GOLIVE_AUDIO=true
# 來源這麼久還沒送來畫面就判定失敗(秒)
# GOLIVE_START_TIMEOUT_S=120
