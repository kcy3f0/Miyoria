# Miyoria voice-node 設定。複製成 .env 後填入。
# .env 已被 .gitignore 排除,絕對不要把真的 token commit 進 repo。

# self 帳號(專用小帳號,不要用主帳號)的 user token,由擁有者自己放進來
SELF_TOKEN=

# Core 的 voice.link 位址與共用 token(要跟 Core 的 [modules."voice.link"] 設定一致)
VOICE_LINK_URL=ws://127.0.0.1:7879/voice-link
VOICE_LINK_TOKEN=

# error | warn | info | debug
LOG_LEVEL=info

# ── 進階(都有預設值,通常不用改)──────────────────────────────
# 停止說話多久(ms)算一段串流結束(stream_close),建議 300~500
# SILENCE_MS=400
# 單一播放最多緩衝幾秒的音訊,超過就判定 failed
# PLAYBACK_MAX_BUFFER_S=60
# 開始播放前先累積幾 ms(避免一開始就斷斷續續)
# PLAYBACK_PREBUFFER_MS=60
# Core 還沒送下一段音訊時最多補靜音幾 ms,超過判定 failed
# PLAYBACK_MAX_STARVE_MS=10000
