{
  "name": "@miyoria/voice-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Miyoria self-account voice node: Discord voice receive / playback bridged to Core over the Voice Link WebSocket protocol",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "report": "node -e \"import('@discordjs/voice').then(v=>console.log(v.generateDependencyReport()))\""
  },
  "dependencies": {
    "@dank074/discord-video-stream": "7.0.0",
    "@discordjs/voice": "0.19.2",
    "@lng2004/discord.js-selfbot-v13": "3.7.2",
    "dotenv": "^18.0.9",
    "opusscript": "0.1.1",
    "prism-media": "1.3.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "zeromq",
      "@snazzah/davey",
      "sharp"
    ]
  }
}
