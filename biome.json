{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "!legacy",
      "!workers",
      "!spikes",
      "!profiles",
      "!extensions/minecraft/mod",
      "!**/dist",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/panel/**",
        "apps/overlay/**",
        "apps/voice-node/**",
        "packages/sdk/**",
        "extensions/minecraft/adapter/**",
        "extensions/examples/hello/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "a11y": "off",
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off",
            "noControlCharactersInRegex": "off",
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off"
          },
          "nursery": {
            "noFloatingPromises": "off",
            "noMisusedPromises": "off"
          }
        }
      }
    }
  ]
}
