# Copy to deploy/.env and change the password.
# These values are read by `docker compose` (interpolation) when run with -f deploy/docker-compose.yml.
# App secrets (LLM key, Discord token, ...) are NOT here: they live in the repo-root .env
# written by `miyoria init`.
POSTGRES_USER=miyoria
# Use URL-safe characters only (letters, digits, - _ .): it is embedded in DATABASE_URL for the core container.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miyoria
# Host port, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# ---- Optional, only for the `core` compose profile ----
# Host ports of the core container (all bound to 127.0.0.1).
#API_PORT=7878
#VOICE_LINK_PORT=7879
#STAGE_LINK_PORT=7882
# Image tag to build / pull.
#MIYORIA_IMAGE=miyoria-core:local
# Use your own container config instead of deploy/miyoria.docker.toml (path relative to deploy/).
#MIYORIA_CONFIG_FILE=./miyoria.docker.toml
# Linux: run as your own user so ../profiles is writable.
#MIYORIA_UID=1000
#MIYORIA_GID=1000
# Database of the core container. Default: the compose postgres above.
# SQLite in the core-data volume instead:
#CORE_DATABASE_URL=sqlite:/data/miyoria.db
# Log level: fatal | error | warn | info | debug | trace.
#MIYORIA_LOG_LEVEL=info
