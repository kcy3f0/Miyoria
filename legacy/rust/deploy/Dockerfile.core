# syntax=docker/dockerfile:1.7
#
# Miyoria Core image (`miyoria core`).
#
# Build context = repo root (the workspace needs every crate):
#   docker build -f deploy/Dockerfile.core -t miyoria-core .
#   # with the admin panel (apps/panel/dist must already be built):
#   docker build -f deploy/Dockerfile.core --build-arg PANEL_DIST=apps/panel/dist -t miyoria-core .
#
# Dependencies are compiled in their own layer via cargo-chef, so a source-only change
# does not rebuild the whole dependency tree. Ignore rules: deploy/Dockerfile.core.dockerignore.

ARG RUST_IMAGE=lukemathwalker/cargo-chef:latest-rust-1-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

# ---- 1. recipe: the dependency skeleton of the workspace ---------------------------------
FROM ${RUST_IMAGE} AS planner
WORKDIR /src
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ---- 2. build: cook dependencies (cached), then compile the binary ----------------------
FROM ${RUST_IMAGE} AS builder
WORKDIR /src
# cmake / protoc: needed by some -sys crates and by the Node Link (gRPC) crates that are added later.
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /src/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo chef cook --release --locked --recipe-path recipe.json --bin miyoria
# NOTE: rust-toolchain.toml is deliberately not special-cased: the image already ships a stable
# toolchain, and COPY . . would otherwise make rustup try to fetch rustfmt/clippy on first use.
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release --locked --bin miyoria \
    && strip target/release/miyoria

# ---- 3. runtime --------------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS runtime

# Directory with the built admin panel. Defaults to an empty placeholder so the build works
# before apps/panel exists; pass --build-arg PANEL_DIST=apps/panel/dist to include it.
ARG PANEL_DIST=deploy/panel-placeholder

LABEL org.opencontainers.image.title="miyoria-core" \
      org.opencontainers.image.description="Miyoria Core node (kernel, agent, Discord bot, admin API)"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 miyoria \
    && useradd --system --uid 10001 --gid miyoria --home-dir /data --shell /usr/sbin/nologin miyoria \
    && mkdir -p /data /profiles /etc/miyoria /opt/panel \
    && chown -R miyoria:miyoria /data

COPY --from=builder /src/target/release/miyoria /usr/local/bin/miyoria
# Container-oriented default config (binds 0.0.0.0 inside the container; compose publishes the
# ports on 127.0.0.1 only). Mount your own file over it to customise.
COPY deploy/miyoria.docker.toml /etc/miyoria/miyoria.toml
COPY ${PANEL_DIST} /opt/panel/

ENV MIYORIA_DATA_DIR=/data \
    MIYORIA_PANEL_DIR=/opt/panel

USER miyoria:miyoria
WORKDIR /data
# Profiles are mounted from the host (compose: ../profiles:/profiles).
VOLUME ["/data"]

# 7878 admin API, 7879 voice link, 7882 stage link. Publish them on 127.0.0.1 only.
EXPOSE 7878 7879 7882

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS http://127.0.0.1:7878/api/health >/dev/null || exit 1

# Core shuts down on SIGINT (tokio ctrl_c), not SIGTERM, so `docker stop` must send SIGINT.
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/tini", "--", "miyoria", "--config", "/etc/miyoria/miyoria.toml"]
CMD ["core"]
