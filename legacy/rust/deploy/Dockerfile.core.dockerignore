# Used by `docker build -f deploy/Dockerfile.core .` (BuildKit picks <Dockerfile>.dockerignore).
.git
.github
.claude
**/target
**/node_modules
**/__pycache__
**/.venv
**/.pytest_cache

# secrets and local state never go into an image
.env
.env.*
**/.env
**/.env.*
!**/.env.example
secrets.toml
miyoria.toml
backups

# local-only assets (licence forbids redistribution) and spike output
profiles/*/avatar/model
profiles/*/voice/*.wav
profiles/*/voice/*.txt
spikes
workers/models

# keep apps/panel/dist (optional PANEL_DIST); everything else under apps/ is not needed to build the binary
apps/voice-node
apps/overlay
packages
