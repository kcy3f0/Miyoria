{
  "name": "miyoria-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:core": "node -e \"console.error('apps/core is not ported yet; it will run as: tsx --conditions=@miyoria/source apps/core/src/main.ts'); process.exit(1)\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@snazzah/davey",
      "esbuild",
      "sharp",
      "zeromq"
    ]
  }
}
