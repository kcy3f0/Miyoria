{
  "name": "@miyoria/card-face",
  "version": "0.1.0",
  "description": "The member card as an SVG (shared by the panel and the Core's link-preview renderer)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "@miyoria/source": "./src/render.tsx",
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "^19.1.0",
    "uqr": "0.1.2",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "@types/react-dom": "^19.1.6"
  }
}
