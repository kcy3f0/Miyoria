{
  "name": "@miyoria/memory",
  "version": "0.1.0",
  "description": "Long-term memory: consolidation, hybrid retrieval, privacy scopes, followups, memory tools and commands",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rescope-self-notes": "tsx --conditions=@miyoria/source scripts/rescope-self-notes.ts"
  },
  "dependencies": {
    "@miyoria/commands": "workspace:*",
    "@miyoria/kernel": "workspace:*",
    "@miyoria/llm": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/tools": "workspace:*",
    "@miyoria/types": "workspace:*",
    "@node-rs/jieba": "^2.0.4",
    "opencc-js": "^1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
