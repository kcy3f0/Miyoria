{
  "name": "@miyoria/sdk",
  "version": "0.1.0",
  "description": "SDK for Miyoria extensions: JSON-RPC over stdio, tools, commands, events, prompts, game adapters",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
