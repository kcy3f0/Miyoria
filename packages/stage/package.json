{
  "name": "@miyoria/stage",
  "version": "0.1.0",
  "description": "Stage: the Core-side stage link (module `stage.link`) and the Stage node runtime (VTube Studio, lip sync, OBS, overlay)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/actions": "workspace:*",
    "@miyoria/commands": "workspace:*",
    "@miyoria/kernel": "workspace:*",
    "@miyoria/llm": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/types": "workspace:*",
    "obs-websocket-js": "^5.0.6",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@miyoria/tools": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
