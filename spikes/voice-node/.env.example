# ─────────────────────────────────────────────────────────────
# Miyoria voice-node spike 設定。複製成 .env 後填入。
# .env 已被 .gitignore 排除,絕對不要把真的 token commit 進 repo。
# ─────────────────────────────────────────────────────────────

# 專用小帳號(不要用主帳號)的 user token,由擁有者自己提供
DISCORD_SELF_TOKEN=

# 要加入的伺服器與語音頻道(開發者模式 → 右鍵 → 複製 ID)
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# ── receive ──────────────────────────────────────────────────
# 語音後端:djs = @discordjs/voice(有 DAVE)+ selfbot 的 voiceAdapterCreator
#           selfbot = discord.js-selfbot-v13 內建語音(沒有 DAVE,當對照組)
RECEIVE_BACKEND=djs
# WAV 輸出資料夾
RECORDINGS_DIR=recordings
# 靜音多久(ms)算一段話結束
RECEIVE_SILENCE_MS=800
# 輸出聲道:1 = 下混成單聲道(ASR 用),2 = 保留 Discord 的立體聲
RECEIVE_CHANNELS=1
# 少於這個長度(ms)的片段丟掉(咳嗽、按鍵聲)
RECEIVE_MIN_MS=300

# ── play ─────────────────────────────────────────────────────
PLAY_BACKEND=djs
# 任何 ffmpeg 讀得懂的音檔(模擬 TTS 輸出)
PLAY_FILE=sample.wav
# 播完之後再播幾次(量多次的啟動延遲)
PLAY_REPEAT=3
# ffmpeg = 交給函式庫現場轉碼;raw = 先解成 PCM 再餵(最接近 TTS 串流)
PLAY_MODES=ffmpeg,raw

# ── golive ───────────────────────────────────────────────────
# dvs = discord-video-stream 自己進語音(會自我拒聽,收不到音)
# hybrid = @discordjs/voice 持有語音(可收音),只借 session 給 dvs 開 Go Live(實驗性)
GOLIVE_VOICE=dvs
# 本機影片檔,或 OBS 推過來的串流:
#   rtmp://127.0.0.1:1935/live/miyoria   (OBS:自訂伺服器 rtmp://127.0.0.1:1935/live,串流金鑰 miyoria)
#   srt://127.0.0.1:9000?mode=listener    (OBS:srt://127.0.0.1:9000?mode=caller)
GOLIVE_INPUT=sample.mp4
# 1 = 本機影片無限循環(長時間量資源用)
GOLIVE_LOOP=0
# nvenc | software
GOLIVE_ENCODER=nvenc
# NVENC preset p1(最快)~ p7(最好)
GOLIVE_NVENC_PRESET=p4
# H264 | H265
GOLIVE_CODEC=H264
GOLIVE_HEIGHT=1080
GOLIVE_FPS=60
GOLIVE_BITRATE_KBPS=6000
GOLIVE_BITRATE_MAX_KBPS=8000
# 1 = 不轉碼直接送(OBS 要設成 H264、關 B-frame、關鍵影格 1 秒),見 README 的 R9
GOLIVE_NO_TRANSCODE=0
# 1 = 用 GPU 解碼輸入(-hwaccel auto)
GOLIVE_HWACCEL_DECODE=1
# 1 = 每 2 秒用 nvidia-smi dmon 取樣 GPU / NVENC 使用率
GOLIVE_GPU_MONITOR=1

# ── 除錯 ─────────────────────────────────────────────────────
# 1 = 印出 @discordjs/voice 全部 debug 訊息(預設只印 DAVE / 加密相關)
VOICE_DEBUG=0
# @dank074/discord-video-stream 的日誌(debug-level 套件);conn:dave 會印 DAVE 交握
DEBUG=conn,conn:dave,playStream
DEBUG_LEVEL=INFO
# ffmpeg 位置(預設用 PATH 上的 ffmpeg;需要有 libopus,Go Live 音量控制需要 libzmq)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
